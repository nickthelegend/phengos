{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@iwsdk/vite-plugin-dev/client"
    ],
    "paths": {
      "@phengos/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}